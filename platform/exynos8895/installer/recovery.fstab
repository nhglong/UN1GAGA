# Android fstab file.
#<src>                  <mnt_point>         <type>    <mnt_flags and options>                               <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

/dev/block/platform/11120000.ufs/by-name/SYSTEM     /system		ext4    ro	wait,first_stage_mount
/dev/block/platform/11120000.ufs/by-name/PRODUCT    /product	ext4    ro	wait,first_stage_mount
/dev/block/platform/11120000.ufs/by-name/VENDOR     /vendor		ext4    ro	wait,first_stage_mount
/dev/block/platform/11120000.ufs/by-name/BOOT           /boot       emmc    defaults defaults
/dev/block/platform/11120000.ufs/by-name/RECOVERY       /recovery   emmc    defaults defaults
/dev/block/platform/11120000.ufs/by-name/CACHE	/cache	ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic	wait,check
/dev/block/platform/11120000.ufs/by-name/OMR    /metadata       ext4    nosuid,nodev,noatime,discard,data=journal,commit=1              wait,check,formattable,first_stage_mount,check,metadata_csum
/dev/block/platform/11120000.ufs/by-name/USERDATA	/data	ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic	wait,check,quota,reservedsize=128M
/dev/block/platform/11120000.ufs/by-name/USERDATA	/data	f2fs	noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678	latemount,wait,check,quota,reservedsize=128M,checkpoint=fs
/dev/block/platform/11120000.ufs/by-name/EFS	/mnt/vendor/efs	ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,errors=panic	wait,check

# ADD FOR CSC
/dev/block/platform/11120000.ufs/by-name/PRISM	/prism		erofs    ro	nofail,wait
/dev/block/platform/11120000.ufs/by-name/OPTICS	/optics     erofs    ro	nofail,wait

# ADD FOR GOTA
/dev/block/platform/11120000.ufs/by-name/MISC           /misc       emmc    defaults                                                                                                          defaults

# VOLD :: fstab.samsungexynos8895
/devices/platform/11500000.dwmmc2/mmc_host*             auto        vfat    defaults    voldmanaged=sdcard:auto
/devices/platform/10c00000.usb/10c00000.dwc3*		auto        auto    defaults    voldmanaged=usb:auto

/dev/block/zram0	none		swap	defaults	zramsize=2684354560,max_comp_streams=8
